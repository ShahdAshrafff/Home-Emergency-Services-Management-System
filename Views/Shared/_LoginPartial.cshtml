@using Microsoft.AspNetCore.Identity
@using HomeServices.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item me-3">
        <a class="nav-link text-dark fw-bold" asp-controller="Account" asp-action="Profile">
            <i class="fas fa-user-circle me-1"></i> Hello @((await UserManager.GetUserAsync(User))?.FullName ?? User.Identity?.Name)!
        </a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item me-3">
        <a class="nav-link text-dark fw-bold" asp-controller="Account" asp-action="Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="btn text-white rounded-pill px-4 py-2 fw-bold shadow-sm" 
           style="background-color: #1a237e;" 
           asp-controller="Account" asp-action="Login">Sign In</a>
    </li>
}
</ul>