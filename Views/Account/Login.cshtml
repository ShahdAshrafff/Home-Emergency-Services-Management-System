@model HomeServices.ViewModels.LoginVM
@{
    ViewData["Title"] = "Sign In";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-wrapper">
    <div class="auth-card text-center">
        <h1 class="auth-title">Sign In</h1>
        <p class="auth-subtitle">Sign in to manage your professional services</p>

        <form asp-action="Login" asp-controller="Account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="text-start mb-4">
                <label asp-for="Email" class="form-label-custom">Email Address</label>
                <div class="input-group-auth">
                    <i class="fas fa-envelope"></i>
                    <input asp-for="Email" class="form-control-auth" placeholder="name@company.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="text-start mb-4">
                <div class="d-flex justify-content-between">
                    <label asp-for="Password" class="form-label-custom">Password</label>
                    <a href="#" class="small text-decoration-none" style="color: #00897b; font-weight: 600;">Forgot Password?</a>
                </div>
                <div class="input-group-auth">
                    <i class="fas fa-lock"></i>
                    <input asp-for="Password" type="password" class="form-control-auth" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-auth-primary mb-4">
                Login to Account <i class="fas fa-arrow-right"></i>
            </button>

            <div class="mt-4">
                <p class="text-muted small">
                    New to ProHome Services? 
                    <a asp-controller="Account" asp-action="Register" class="auth-footer-link">Create Account</a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}